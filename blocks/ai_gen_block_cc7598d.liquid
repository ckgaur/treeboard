
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-mobile-slider-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;height:{{ block.settings.section_height }}px;background:{{ block.settings.background_color }};overflow:hidden}.ai-mobile-slider__track-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));height:100%}.ai-mobile-slider__item-{{ ai_gen_id }}{position:relative;display:flex;align-items:center;gap:10px;padding:12px 14px;min-width:0;justify-content: center;}.ai-mobile-slider__item-{{ ai_gen_id }}:not(:last-child):after{content:'';position:absolute;top:25%;right:0;width:1px;height:50%;background:#000}.ai-mobile-slider__image-{{ ai_gen_id }}{flex:0 0 {{ block.settings.image_size }}px;width:{{ block.settings.image_size }}px;height:{{ block.settings.image_size }}px;background:{{ block.settings.image_background }};border-radius:{{ block.settings.image_radius }}px;overflow:hidden}.ai-mobile-slider__image-{{ ai_gen_id }} img,.ai-mobile-slider__image-{{ ai_gen_id }} svg{width:100%;height:100%;object-fit:cover}.ai-mobile-slider__heading-{{ ai_gen_id }}{margin:0 0 4px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px}.ai-mobile-slider__text-{{ ai_gen_id }}{color:{{ block.settings.text_color }};font-size:{{ block.settings.text_size }}px}.ai-mobile-slider__text-{{ ai_gen_id }} p{margin:0}.ai-mobile-slider__controls-{{ ai_gen_id }}{display:none}@media(max-width:749px){.ai-mobile-slider-{{ ai_gen_id }}{height:auto}.ai-mobile-slider__track-{{ ai_gen_id }}{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;height:{{ block.settings.section_height }}px}.ai-mobile-slider__track-{{ ai_gen_id }}::-webkit-scrollbar{display:none}.ai-mobile-slider__item-{{ ai_gen_id }}{flex:0 0 100%;scroll-snap-align:start;box-sizing:border-box}.ai-mobile-slider__item-{{ ai_gen_id }}:not(:last-child):after{top:auto;right:10%;bottom:0;width:80%;height:1px}.ai-mobile-slider__controls-{{ ai_gen_id }}{display:flex;position:absolute;right:10px;bottom:8px;gap:6px}.ai-mobile-slider-{{ ai_gen_id }}{position:relative}.ai-mobile-slider__button-{{ ai_gen_id }}{width:28px;height:28px;border:1px solid #171c25;border-radius:50%;background:{{ block.settings.background_color }};color:#171c25;cursor:pointer}}
{% endstyle %}
<mobile-info-slider-{{ ai_gen_id }}
  class="ai-mobile-slider-{{ ai_gen_id }} wrapper section-padding"
  {{ block.shopify_attributes }}
>
<div class="ai-mobile-slider__track-{{ ai_gen_id }}">
  {% for i in (1..5) -%}
    {%- assign image_key = 'column_' | append: i | append: '_image' -%}
    {%- assign heading_key = 'column_' | append: i | append: '_heading' -%}
    {%- assign text_key = 'column_' | append: i | append: '_text' -%}
    {%- assign image = block.settings[image_key] -%}
    {%- assign heading = block.settings[heading_key] -%}
    {%- assign text = block.settings[text_key] -%}

    {% if heading_key != blank %}
      <div class="ai-mobile-slider__item-{{ ai_gen_id }}">
        
        <div class="ai-mobile-slider__image-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 200 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div>
          {% if heading != blank %}
            <h2 class="ai-mobile-slider__heading-{{ ai_gen_id }}">
              {{ heading | escape }}
            </h2>
          {% endif %}

          <div class="ai-mobile-slider__text-{{ ai_gen_id }}">
            {{ text }}
          </div>
        </div>

      </div>
    {% endif %}
  {% endfor %}
</div>

  <div class="ai-mobile-slider__controls-{{ ai_gen_id }}">
    <button class="ai-mobile-slider__button-{{ ai_gen_id }}" type="button" data-dir="prev" aria-label="Previous">
      ‹</button
    ><button class="ai-mobile-slider__button-{{ ai_gen_id }}" type="button" data-dir="next" aria-label="Next">›</button>
  </div>
</mobile-info-slider-{{ ai_gen_id }}>
<script>
  (function(){class MobileInfoSlider{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.t=this.querySelector('.ai-mobile-slider__track-{{ ai_gen_id }}');this.querySelectorAll('[data-dir]').forEach(b=>b.addEventListener('click',()=>this.t.scrollBy({left:(b.dataset.dir==='next'?1:-1)*this.t.clientWidth,behavior:'smooth'})))}}customElements.define('mobile-info-slider-{{ ai_gen_id }}',MobileInfoSlider{{ ai_gen_id }})})();
</script>
