<div class="tree-to-table-section" >
  <div class="tree-to-table-section__inner page-width wrapper section-padding" style="background-color: {{ section.settings.bg_color }};">
    <div class="tree-to-table-section__grid">

      <div class="tree-to-table-section__media">
        {% if section.settings.video_url != blank %}
          <div class="tree-to-table-section__embed">
            {% if section.settings.video_url.type == 'youtube' %}
              <iframe
                src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}"
                title="{{ section.settings.heading | escape }}"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {% elsif section.settings.video_url.type == 'vimeo' %}
              <iframe
                src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
                title="{{ section.settings.heading | escape }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {% endif %}
          </div>
        {% elsif section.settings.video %}
          {{ section.settings.video | video_tag: image_size: '1000x', autoplay: false, loop: false, controls: true, muted: false }}
        {% elsif section.settings.image %}
          {{ section.settings.image | image_url: width: 1000 | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000,1200',
              class: 'tree-to-table-section__image'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'tree-to-table-section__image placeholder' }}
        {% endif %}

        {% if section.settings.overlay_text != blank %}
          <div class="tree-to-table-section__overlay-text">{{ section.settings.overlay_text }}</div>
        {% endif %}
      </div>

      <div class="tree-to-table-section__content">
        {% if section.settings.heading != blank %}
          <h2 class="tree-to-table-section__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="tree-to-table-section__text">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <hr class="tree-to-table-section__divider">
          <div class="tree-to-table-section__features">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'feature' %}
                  <div class="tree-to-table-section__feature" {{ block.shopify_attributes }}>
                    {% if block.settings.icon != blank %}
                      <span class="tree-to-table-section__feature-icon">
                        {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
                      </span>
                    {% endif %}
                    <span class="tree-to-table-section__feature-label">{{ block.settings.label }}</span>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <div class="tree-to-table-section__cta">
            <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% style %}
  .tree-to-table-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .tree-to-table-section__inner {
    border-radius: 16px;
    padding: 40px;
  }

  .tree-to-table-section__grid {
    display: grid;
    grid-template-columns: 2.1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .tree-to-table-section__media {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }

  .tree-to-table-section__media img,
  .tree-to-table-section__media video,
  .tree-to-table-section__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 12px;
  }

  .tree-to-table-section__embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
  }

  .tree-to-table-section__embed iframe,
  .tree-to-table-section__embed > div {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tree-to-table-section__overlay-text {
    position: absolute;
    left: 24px;
    bottom: 24px;
    color: #fff;
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.1;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0,0,0,0.35);
    max-width: 60%;
  }

  .tree-to-table-section__heading {
    font-size: 2.25rem;
    margin: 0 0 16px;
  }

  .tree-to-table-section__text {
    font-size: 1rem;
    line-height: 1.6;
    color: #000;
    margin-bottom: 24px;
  }

  .tree-to-table-section__divider {
    border: none;
    border-top: 1px solid rgba(0,0,0,0.15);
    margin: 0 0 24px;
  }

  .tree-to-table-section__features {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tree-to-table-section__feature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 1.05rem;
  }

  .tree-to-table-section__feature-icon img {
    width: 24px;
    height: 24px;
    display: block;
  }

  .tree-to-table-section__cta {
    margin-top: 24px;
  }

  @media screen and (max-width: 749px) {
    .tree-to-table-section__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .tree-to-table-section__inner {
      padding: 24px;
    }

    .tree-to-table-section__heading {
      font-size: 1.75rem;
    }

    .tree-to-table-section__overlay-text {
      font-size: 1.5rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Tree to Table",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube or Vimeo video",
      "accept": ["youtube", "vimeo"],
      "info": "Takes priority over the video and image below if set"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded to Shopify)",
      "info": "Used if no YouTube/Vimeo link is set above; takes priority over the image below"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used if no video is selected"
    },
    {
      "type": "text",
      "id": "overlay_text",
      "label": "Overlay text",
      "default": "Naturally Unique"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Tree to Table"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Handcrafted from solid, natural hardwood in our Maryland workshop, every Treeboard product is made to bring lasting beauty and everyday function to your kitchen. See what makes our boards different.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FBF3E3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Feature label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tree to Table",
      "settings": {
        "heading": "From Tree to Table",
        "overlay_text": "Naturally Unique",
        "bg_color": "#FBF3E3"
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "label": "Glue Free"
          }
        },
        {
          "type": "feature",
          "settings": {
            "label": "No fillers"
          }
        },
        {
          "type": "feature",
          "settings": {
            "label": "Just Solid Hardwood"
          }
        }
      ]
    }
  ]
}
{% endschema %}
