{"sections":{"banner":{"type":"collection-banner","blocks":{"collections":{"type":"heading","settings":{"text_size":9}}},"block_order":["collections"],"settings":{"flex_align":"align--middle-left","show_title_below":false,"show_description_below":false,"show_image":true,"image_height":"use_screen_one_fifth","overlay_opacity":20,"overlay_color":"#000000","color":"text--white","color_bg":"hero__content--transparent","width":"wrapper--none","padding_top":0,"padding_bottom":0}},"main":{"type":"collection","settings":{"bg":"palette--light bg--neutral","pagination_count":12,"grid_setting_large":3,"grid_setting_medium":2,"grid_setting_small":2,"show_collection_nav":true,"collection_custom_nav_list":"footer","align_nav":"inline-nav","collection_sorting":true,"filters":true,"width":"wrapper","padding_top":36,"padding_bottom":64}},"section_liquid_BQT4tX":{"type":"section-liquid","custom_css":["{background: #fff9eb;}"],"name":"Custom Liquid","settings":{"custom_liquid":"<div class=\"col-des wrapper section-padding accordion__container accordion__container--grid\" style=\"background:#FFF9EB; padding-top:3%;padding-bottom:5%;\">{{collection.description}}<\/div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  const accordion = document.querySelector('.treeboard-accordion');\n\n  if (!accordion) {\n    console.log('Treeboard accordion not found.');\n    return;\n  }\n\n  const items = accordion.querySelectorAll('.accordion__wrapper');\n\n  console.log('Treeboard accordion initialized:', items.length);\n\n\n  \/*\n   * OPEN ACCORDION\n   *\/\n  function openAccordion(item) {\n\n    const button = item.querySelector('.accordion__title');\n    const body = item.querySelector('.accordion__body');\n\n    if (!button || !body) return;\n\n    button.classList.add('accordion-is-open');\n\n    button.setAttribute('aria-expanded', 'true');\n\n    body.setAttribute('aria-hidden', 'false');\n\n  }\n\n\n  \/*\n   * CLOSE ACCORDION\n   *\/\n  function closeAccordion(item) {\n\n    const button = item.querySelector('.accordion__title');\n    const body = item.querySelector('.accordion__body');\n\n    if (!button || !body) return;\n\n    button.classList.remove('accordion-is-open');\n\n    button.setAttribute('aria-expanded', 'false');\n\n    body.setAttribute('aria-hidden', 'true');\n\n  }\n\n\n  \/*\n   * INITIALIZE\n   *\/\n  items.forEach(function (item, index) {\n\n    const button = item.querySelector('.accordion__title');\n    const body = item.querySelector('.accordion__body');\n\n    if (!button || !body) return;\n\n\n    \/*\n     * Give body an ID if it doesn't have one\n     *\/\n    if (!body.id) {\n\n      body.id = 'treeboard-accordion-body-' + index;\n\n    }\n\n\n    \/*\n     * Connect button and body\n     *\/\n    button.setAttribute(\n      'aria-controls',\n      body.id\n    );\n\n\n    \/*\n     * Existing accordion-is-open class\n     * determines initial state.\n     *\/\n    if (\n      button.classList.contains('accordion-is-open')\n    ) {\n\n      openAccordion(item);\n\n    } else {\n\n      closeAccordion(item);\n\n    }\n\n  });\n\n\n  \/*\n   * CLICK HANDLER\n   *\n   * Event delegation means this continues\n   * to work even if Shopify dynamically\n   * replaces the section.\n   *\/\n  accordion.addEventListener(\n    'click',\n    function (event) {\n\n      const button =\n        event.target.closest('.accordion__title');\n\n      if (!button) return;\n\n      const item =\n        button.closest('.accordion__wrapper');\n\n      if (!item) return;\n\n\n      \/*\n       * Prevent the theme's generic accordion\n       * from interfering with this custom accordion.\n       *\/\n      event.preventDefault();\n      event.stopPropagation();\n\n\n      const isOpen =\n        button.classList.contains(\n          'accordion-is-open'\n        );\n\n\n      \/*\n       * Close every other accordion\n       *\/\n      items.forEach(function (otherItem) {\n\n        if (otherItem !== item) {\n      closeAccordion(otherItem);\n        }\n      });\n\n      \/*\n       * Toggle current accordion\n       *\/\n      if (isOpen) {\n        closeAccordion(item);\n\n      } else {\n        openAccordion(item);\n      }\n    },\n    true\n  );\n\n});\n<\/script>"}},"section_newsletter_73iNki":{"type":"section-newsletter","name":"Newsletter","settings":{"enable_klaviyo":true,"title":"Newsletter","richtext":"<p>Get an extra $15 and be the first to know about our exclusive offers.<\/p>","success":"Success! Use code CLUB10 to save 10%","text_color":"text--neutral","color_bg":"palette--light bg--neutral","button_color":"btn--neutral","button_style":"btn--soft","width":"wrapper","padding_top":0,"padding_bottom":0}}},"order":["banner","main","section_liquid_BQT4tX","section_newsletter_73iNki"]}